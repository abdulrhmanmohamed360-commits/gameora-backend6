# انسخ الملف ده لاسم .env جوه مجلد functions وحط فيه قيم حقيقية قبل النشر.
# متعملش commit لملف .env نفسه (هو متجاهل في .gitignore أصلاً).

# مفتاح سري لتوقيع الـ JWT بتاع تسجيل الدخول - خليه طويل وعشوائي
JWT_SECRET=change-this-to-a-long-random-secret

# مفتاح بسيط لحماية GET/POST /admin/seed (صفحة public/seed.html بتستخدمه)
ADMIN_SEED_KEY=change-this-too
